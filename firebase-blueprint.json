    "system_releases": {
      "title": "System Releases & Updates",
      "description": "Published app updates, version metadata and changelogs",
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "buildNumber": {
          "type": "number"
        },
        "releaseTitle": {
          "type": "string"
        },
        "releaseNotes": {
          "type": "string"
        },
        "isForceUpdate": {
          "type": "boolean"
        },
        "publishedBy": {
          "type": "string"
        },
        "publishedAt": {
          "type": "number"
        }
      },
      "required": [
        "version",
        "buildNumber",
        "releaseTitle",
        "publishedAt"
      ]
    },
    "merchant_cloud_configs": {
      "title": "Merchant Cloud Database Configs",
      "description": "Supabase or cloud DB credentials linked to merchant phone",
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "projectUrl": { "type": "string" },
        "apiKey": { "type": "string" },
        "isConnected": { "type": "boolean" },
        "merchantPhone": { "type": "string" },
        "merchantShopName": { "type": "string" },
