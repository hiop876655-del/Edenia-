        "lastSyncedAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["projectUrl", "apiKey", "merchantPhone"]
    },
    "system_config": {
      "title": "System Global Configuration",
      "description": "Global tutorials, video URLs, and platform parameters",
      "type": "object",
      "properties": {
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "providerRegisterUrl": { "type": "string" },
        "updatedAt": { "type": "number" }
      }
    }
